<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
    <SolidColorBrush x:Key="AccentText" Color="#99DCFF"/>
    <SolidColorBrush x:Key="AccentSoft" Color="#1A2A36"/>
    <SolidColorBrush x:Key="AccentBorder" Color="#2D6086"/>
    <SolidColorBrush x:Key="OnAccent" Color="#000000"/>
    <SolidColorBrush x:Key="WindowBg" Color="#202020"/>
    <SolidColorBrush x:Key="SidebarBg" Color="#202020"/>
    <SolidColorBrush x:Key="CardBg" Color="#2B2B2B"/>
    <SolidColorBrush x:Key="CardHover" Color="#323232"/>
    <SolidColorBrush x:Key="Stroke" Color="#363636"/>
    <SolidColorBrush x:Key="StrokeStrong" Color="#454545"/>
    <SolidColorBrush x:Key="ControlBottom" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="TextTertiary" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="InputBg" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="InputHover" Color="#323232"/>
    <SolidColorBrush x:Key="SubtleFill" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="SubtlePressed" Color="#292929"/>
    <SolidColorBrush x:Key="NavSelected" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="Overlay" Color="#80000000"/>
    <SolidColorBrush x:Key="DialogFooter" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="Danger" Color="#FF99A4"/>
    <SolidColorBrush x:Key="DangerSoft" Color="#3B2324"/>
    <SolidColorBrush x:Key="DangerBorder" Color="#7A3A3F"/>
    <SolidColorBrush x:Key="Success" Color="#6CCB5F"/>
    <SolidColorBrush x:Key="SuccessSoft" Color="#24301F"/>
    <SolidColorBrush x:Key="Warning" Color="#FCE100"/>
    <SolidColorBrush x:Key="WarningSoft" Color="#3A3217"/>
    <SolidColorBrush x:Key="ToggleOffBorder" Color="#A0A0A0"/>
    <SolidColorBrush x:Key="ToggleOffKnob" Color="#D0D0D0"/>
    <SolidColorBrush x:Key="ScrollThumb" Color="#5A5A5A"/>
    <LinearGradientBrush x:Key="ControlBorder" MappingMode="Absolute" StartPoint="0,0" EndPoint="0,3">
        <LinearGradientBrush.RelativeTransform>
            <ScaleTransform ScaleY="-1" CenterY="0.5"/>
        </LinearGradientBrush.RelativeTransform>
        <GradientStop Offset="0.33" Color="#12FFFFFF"/>
        <GradientStop Offset="1.0" Color="#17FFFFFF"/>
    </LinearGradientBrush>
</ResourceDictionary>
