<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>WtfNel.Ui</RootNamespace>
    <AssemblyName>WtfNel.Ui</AssemblyName>
    <Version>1.0.0</Version>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\WtfNel.Core\WtfNel.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\WtfNel.Core\Assets\LocalRuntime\**\*" Link="LocalRuntime\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <Target Name="BuildStub" BeforeTargets="Build;Publish">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WtfNel.Stub\WtfNel.Stub.csproj"
             Targets="Build" Properties="Configuration=$(Configuration)" />
  </Target>

  <Target Name="CopyStubToOutput" AfterTargets="Build">
    <ItemGroup>
      <_StubOut Include="$(MSBuildThisFileDirectory)..\WtfNel.Stub\bin\$(Configuration)\net9.0\WPFLauncher.*" />
    </ItemGroup>
    <Copy SourceFiles="@(_StubOut)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyStubToPublish" AfterTargets="Publish">
    <PropertyGroup>
      <_StubPublishDir>$(MSBuildThisFileDirectory)..\WtfNel.Stub\bin\publish\</_StubPublishDir>
    </PropertyGroup>
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\WtfNel.Stub\WtfNel.Stub.csproj" Targets="Publish"
             Properties="Configuration=Release;RuntimeIdentifier=win-x64;SelfContained=true;PublishSingleFile=true;PublishTrimmed=true;EnableCompressionInSingleFile=true;DebugType=none;PublishDir=$(_StubPublishDir)" />
    <Delete Files="$(PublishDir)WPFLauncher.dll;$(PublishDir)WPFLauncher.deps.json;$(PublishDir)WPFLauncher.runtimeconfig.json" />
    <Copy SourceFiles="$(_StubPublishDir)WPFLauncher.exe" DestinationFolder="$(PublishDir)" />
  </Target>

  <PropertyGroup>
    <NativePayloadBuildDir>$(MSBuildThisFileDirectory)..\..\native\build</NativePayloadBuildDir>
    <NativePayloadPrebuiltDir>$(MSBuildThisFileDirectory)..\..\native\prebuilt</NativePayloadPrebuiltDir>
    <NativePayloadDir Condition="'$(NativePayloadDir)' == ''">$(NativePayloadPrebuiltDir)</NativePayloadDir>
    <BuildNativePayload Condition="'$(BuildNativePayload)' == ''">false</BuildNativePayload>
  </PropertyGroup>

  <Target Name="BuildNativePayloads" BeforeTargets="Build"
          Condition="'$(SkipNativePayload)' != 'true' and '$(BuildNativePayload)' == 'true'">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildThisFileDirectory)..\..\native\build.ps1&quot; -Configuration Release"
          ContinueOnError="true" />
    <PropertyGroup>
      <NativePayloadDir Condition="Exists('$(NativePayloadBuildDir)\WtfNel.Payload.Proxy.dll')">$(NativePayloadBuildDir)</NativePayloadDir>
    </PropertyGroup>
    <Message Importance="high" Text="[native] payload 取自 $(NativePayloadDir)" />
  </Target>

  <Target Name="CopyPayloadsToOutput" AfterTargets="Build" Condition="'$(SkipNativePayload)' != 'true'">
    <ItemGroup>
      <_PayloadNative Include="$(NativePayloadDir)\WtfNel.Payload.HwidSpoof.dll" />
      <_PayloadNative Include="$(NativePayloadDir)\WtfNel.Payload.Proxy.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PayloadNative)" DestinationFolder="$(OutDir)payloads" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

  <Target Name="CopyPayloadsToPublish" AfterTargets="Publish" Condition="'$(SkipNativePayload)' != 'true'">
    <ItemGroup>
      <_PayloadNativePublish Include="$(NativePayloadDir)\WtfNel.Payload.HwidSpoof.dll" />
      <_PayloadNativePublish Include="$(NativePayloadDir)\WtfNel.Payload.Proxy.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_PayloadNativePublish)" DestinationFolder="$(PublishDir)payloads" SkipUnchangedFiles="true" ContinueOnError="true" />
  </Target>

</Project>
