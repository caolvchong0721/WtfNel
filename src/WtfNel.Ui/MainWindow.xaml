<Window x:Class="WtfNel.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:WtfNel.Ui.Controls"
        Title="WtfNel" Width="1080" Height="700" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource WindowBg}" FontFamily="{StaticResource UiFont}" FontSize="14"
        Foreground="{DynamicResource TextPrimary}" UseLayoutRounding="True">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Grid.ColumnSpan="2" Text="WtfNel" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                   VerticalAlignment="Center" Margin="18,0,0,0"/>

        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
            <Button Style="{StaticResource Btn.Caption}" Click="OnMinimize">
                <c:SvgIcon Data="{StaticResource I.Minimize}" Width="12" Height="12" StrokeThickness="1.4" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button Style="{StaticResource Btn.Caption}" Click="OnMaximize">
                <c:SvgIcon x:Name="MaxIcon" Data="{StaticResource I.Maximize}" Width="11" Height="11" StrokeThickness="1.4" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
            <Button Style="{StaticResource Btn.CaptionClose}" Click="OnClose">
                <c:SvgIcon Data="{StaticResource I.Close}" Width="12" Height="12" StrokeThickness="1.4" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            </Button>
        </StackPanel>

        <DockPanel Grid.Row="1" Grid.Column="0" Margin="6,4,6,8">
            <StackPanel DockPanel.Dock="Bottom">
                <Border x:Name="UpdateBanner" Visibility="Collapsed" Cursor="Hand" CornerRadius="{StaticResource Radius}" Padding="12,8,12,9" Margin="4,0,4,6"
                        Background="{DynamicResource AccentSoft}" BorderBrush="{DynamicResource AccentBorder}" BorderThickness="1"
                        MouseLeftButtonUp="OnUpdateBannerClick">
                    <DockPanel>
                        <c:SvgIcon Data="{StaticResource I.Download}" Width="14" Height="14" Foreground="{DynamicResource AccentText}" DockPanel.Dock="Left" Margin="0,0,10,0"/>
                        <TextBlock x:Name="UpdateTitle" Text="有新版本" FontSize="13" Foreground="{DynamicResource AccentText}" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
                <Border x:Name="RunningBadge" Visibility="Collapsed" CornerRadius="{StaticResource Radius}" Padding="12,8,12,9" Margin="4,0,4,6"
                        Background="{DynamicResource SuccessSoft}">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Success}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Text="游戏运行中" FontSize="13" Foreground="{DynamicResource Success}"/>
                    </StackPanel>
                </Border>
                <RadioButton x:Name="NavAbout" GroupName="Nav" Style="{StaticResource NavItem}" Tag="about" Checked="OnNav">
                    <StackPanel Orientation="Horizontal">
                        <c:SvgIcon Data="{StaticResource I.Info}"/>
                        <TextBlock Text="关于" Margin="14,0,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavSettings" GroupName="Nav" Style="{StaticResource NavItem}" Tag="settings" Checked="OnNav">
                    <StackPanel Orientation="Horizontal">
                        <c:SvgIcon Data="{StaticResource I.Sliders}"/>
                        <TextBlock Text="设置" Margin="14,0,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <StackPanel>
                <RadioButton x:Name="NavHome" GroupName="Nav" Style="{StaticResource NavItem}" Tag="home" Checked="OnNav">
                    <StackPanel Orientation="Horizontal">
                        <c:SvgIcon Data="{StaticResource I.Home}"/>
                        <TextBlock Text="主页" Margin="14,0,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavAccounts" GroupName="Nav" Style="{StaticResource NavItem}" Tag="accounts" Checked="OnNav">
                    <StackPanel Orientation="Horizontal">
                        <c:SvgIcon Data="{StaticResource I.Users}"/>
                        <TextBlock Text="账号" Margin="14,0,0,0"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="NavLogs" GroupName="Nav" Style="{StaticResource NavItem}" Tag="logs" Checked="OnNav">
                    <StackPanel Orientation="Horizontal">
                        <c:SvgIcon Data="{StaticResource I.Terminal}"/>
                        <TextBlock Text="日志" Margin="14,0,0,0"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>
        </DockPanel>

        <Grid x:Name="PageHost" Grid.Row="1" Grid.Column="1" RenderTransformOrigin="0.5,0.3">
            <Grid.RenderTransform>
                <ScaleTransform x:Name="PageScale"/>
            </Grid.RenderTransform>
        </Grid>

        <StackPanel x:Name="ToastLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,24"/>
        <Grid x:Name="DialogLayer" Grid.RowSpan="2" Grid.ColumnSpan="2" Visibility="Collapsed"/>
    </Grid>
</Window>
