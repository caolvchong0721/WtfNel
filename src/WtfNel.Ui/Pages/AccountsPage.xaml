<UserControl x:Class="WtfNel.Ui.Pages.AccountsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WtfNel.Ui.Controls">
    <DockPanel Margin="40,8,40,24">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,20">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" VerticalAlignment="Center" Click="OnAdd">
                <StackPanel Orientation="Horizontal">
                    <c:SvgIcon Data="{StaticResource I.Plus}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                    <TextBlock Text="添加账号" Margin="8,0,0,0"/>
                </StackPanel>
            </Button>
            <TextBlock Text="账号" Style="{StaticResource H1}" Margin="0"/>
        </DockPanel>

        <TextBlock x:Name="Summary" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="1,0,0,8"/>

        <Grid>
            <Border x:Name="EmptyState" Style="{StaticResource Card}" Padding="24" VerticalAlignment="Top" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="还没有保存的账号" Style="{StaticResource H2}"/>
                    <TextBlock Text="账号以明文保存在程序目录的 accounts.json 里。" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <ListBox x:Name="List" ItemContainerStyle="{StaticResource PlainListItem}" ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource RowCard}">
                            <DockPanel>
                                <Grid Width="36" Height="36" DockPanel.Dock="Left" Margin="0,0,14,0">
                                    <Ellipse Fill="{DynamicResource SubtleFill}" Stroke="{DynamicResource Stroke}" StrokeThickness="1"/>
                                    <TextBlock Text="{Binding Initial}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Click="OnTest" CommandParameter="{Binding}" MinWidth="72">登录</Button>
                                    <Button Click="OnEdit" CommandParameter="{Binding}" Margin="8,0,0,0" MinWidth="72">编辑</Button>
                                    <Button Style="{StaticResource Btn.Icon}" ToolTip="删除" Click="OnDelete" CommandParameter="{Binding}" Margin="4,0,0,0">
                                        <c:SvgIcon Data="{StaticResource I.Trash}" Width="16" Height="16" Foreground="{DynamicResource TextSecondary}"/>
                                    </Button>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Account.Name}" Style="{StaticResource Body}"/>
                                        <Border Style="{StaticResource Badge}" Margin="8,0,0,0">
                                            <TextBlock Text="{Binding Account.ChannelLabel}"/>
                                        </Border>
                                        <TextBlock Text="已登录" FontSize="12" Foreground="{DynamicResource Success}" Margin="8,0,0,0"
                                                   VerticalAlignment="Center" Visibility="{Binding OnlineVisibility}"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Meta}" Style="{StaticResource Muted}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
    </DockPanel>
</UserControl>
