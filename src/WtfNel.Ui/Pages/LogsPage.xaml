<UserControl x:Class="WtfNel.Ui.Pages.LogsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WtfNel.Ui.Controls">
    <DockPanel Margin="40,8,40,24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Btn.Ghost}" Click="OnOpenFolder">
                        <StackPanel Orientation="Horizontal">
                            <c:SvgIcon Data="{StaticResource I.Folder}" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="日志目录" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Btn.Ghost}" Click="OnClear" Margin="6,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <c:SvgIcon Data="{StaticResource I.Trash}" Width="16" Height="16" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                            <TextBlock Text="清空" Margin="8,0,0,0"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <TextBlock Text="日志" Style="{StaticResource H1}" Margin="0"/>
            </DockPanel>

            <DockPanel Margin="0,20,0,0">
                <Border Style="{StaticResource SegmentHost}" DockPanel.Dock="Left">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton GroupName="Level" Style="{StaticResource Segment}" Content="全部" Tag="" IsChecked="True" Checked="OnLevel"/>
                        <RadioButton GroupName="Level" Style="{StaticResource Segment}" Content="警告" Tag="WRN" Checked="OnLevel"/>
                        <RadioButton GroupName="Level" Style="{StaticResource Segment}" Content="错误" Tag="ERR" Checked="OnLevel"/>
                        <RadioButton GroupName="Level" Style="{StaticResource Segment}" Content="调试" Tag="DBG" Checked="OnLevel"/>
                    </StackPanel>
                </Border>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <TextBlock Text="自动滚动" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <CheckBox x:Name="AutoScroll" Style="{StaticResource Toggle}" IsChecked="True"/>
                </StackPanel>
                <TextBox x:Name="SearchBox" Tag="搜索内容或模块，如 login" Margin="16,0,0,0" TextChanged="OnSearch"/>
            </DockPanel>
        </StackPanel>

        <Border Style="{StaticResource Card}" Padding="0" CornerRadius="{StaticResource Radius}">
            <Grid>
                <ListBox x:Name="List" ItemContainerStyle="{StaticResource PlainListItem}" Padding="6,8"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         ScrollViewer.CanContentScroll="True" ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="10,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="64"/>
                                    <ColumnDefinition Width="48"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" FontFamily="{StaticResource MonoFont}" FontSize="12" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Top" Margin="0,2,0,0"/>
                                <Border x:Name="LevelBadge" Grid.Column="1" CornerRadius="4" Padding="5,1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0"
                                        Background="{DynamicResource SubtleFill}">
                                    <TextBlock x:Name="LevelText" Text="{Binding Level}" FontFamily="{StaticResource MonoFont}" FontSize="11" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                </Border>
                                <TextBlock x:Name="TagText" Grid.Column="2" Text="{Binding Tag}" FontFamily="{StaticResource MonoFont}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Accent}" Margin="0,2,10,0" VerticalAlignment="Top"/>
                                <TextBlock x:Name="MessageText" Grid.Column="3" Text="{Binding Message}" FontFamily="{StaticResource MonoFont}" FontSize="12"
                                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding HasTag}" Value="False">
                                    <Setter TargetName="TagText" Property="Margin" Value="0"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="WRN">
                                    <Setter TargetName="LevelBadge" Property="Background" Value="{DynamicResource WarningSoft}"/>
                                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource Warning}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="ERR">
                                    <Setter TargetName="LevelBadge" Property="Background" Value="{DynamicResource DangerSoft}"/>
                                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource Danger}"/>
                                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource Danger}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="DBG">
                                    <Setter TargetName="MessageText" Property="Foreground" Value="{DynamicResource TextSecondary}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Level}" Value="INF">
                                    <Setter TargetName="LevelBadge" Property="Background" Value="{DynamicResource AccentSoft}"/>
                                    <Setter TargetName="LevelText" Property="Foreground" Value="{DynamicResource Accent}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="暂时没有日志" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>
