<UserControl x:Class="WtfNel.Ui.Pages.AboutPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WtfNel.Ui.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,8,40,32">
        <StackPanel MaxWidth="1000">
            <TextBlock Text="关于" Style="{StaticResource H1}"/>

            <Border Style="{StaticResource RowCard}">
                <DockPanel>
                    <c:SvgIcon Data="{StaticResource I.Info}" Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                    <TextBlock x:Name="VersionText" DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="WtfNel" Style="{StaticResource Body}"/>
                        <TextBlock Text="网易我的世界启动器" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Text="更新" Style="{StaticResource Section}"/>
            <Border Style="{StaticResource RowCard}">
                <DockPanel>
                    <c:SvgIcon Data="{StaticResource I.Refresh}" Width="20" Height="20" DockPanel.Dock="Left" Margin="0,0,16,0"/>
                    <Button x:Name="CheckButton" DockPanel.Dock="Right" Style="{StaticResource Btn.Primary}" MinWidth="104" VerticalAlignment="Center" Click="OnCheck">
                        <TextBlock x:Name="CheckText" Text="检查更新"/>
                    </Button>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="UpdateHeadline" Text="检查新版本" Style="{StaticResource Body}"/>
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"/>
                    </StackPanel>
                </DockPanel>
            </Border>
            <ProgressBar x:Name="Checking" Style="{StaticResource ThinProgress}" IsIndeterminate="True" Visibility="Collapsed" Margin="4,0,4,4"/>

            <Border x:Name="ReleaseCard" Style="{StaticResource RowCard}" Visibility="Collapsed">
                <StackPanel Margin="36,0,0,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Click="OnOpenRelease" MinWidth="88">发布页</Button>
                            <Button Style="{StaticResource Btn.Primary}" Click="OnDownload" Margin="8,0,0,0" MinWidth="88">
                                <TextBlock x:Name="DownloadText" Text="下载"/>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="ReleaseTitle" Style="{StaticResource H2}"/>
                            <TextBlock x:Name="ReleaseMeta" Style="{StaticResource Muted}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <TextBlock x:Name="ReleaseNotes" Style="{StaticResource Body}" LineHeight="21" Margin="0,14,0,4" Foreground="{DynamicResource TextSecondary}"/>
                </StackPanel>
            </Border>

            <TextBlock Text="链接" Style="{StaticResource Section}"/>
            <Button Style="{StaticResource Btn.Ghost}" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Stroke}"
                    HorizontalContentAlignment="Stretch" Padding="16,0" Height="56" Margin="0,0,0,4" Click="OnRepo">
                <DockPanel>
                    <c:SvgIcon DockPanel.Dock="Right" Data="{StaticResource I.External}" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}"/>
                    <c:SvgIcon Data="{StaticResource I.Github}" Width="20" Height="20" Margin="0,0,16,0"/>
                    <TextBlock Text="GitHub 仓库" VerticalAlignment="Center"/>
                    <TextBlock x:Name="RepoText" Margin="12,0,0,0" Foreground="{DynamicResource TextTertiary}" FontSize="12" VerticalAlignment="Center"/>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Btn.Ghost}" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Stroke}"
                    HorizontalContentAlignment="Stretch" Padding="16,0" Height="56" Margin="0,0,0,4" Click="OnReleases">
                <DockPanel>
                    <c:SvgIcon DockPanel.Dock="Right" Data="{StaticResource I.External}" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}"/>
                    <c:SvgIcon Data="{StaticResource I.Download}" Width="20" Height="20" Margin="0,0,16,0"/>
                    <TextBlock Text="所有版本" VerticalAlignment="Center"/>
                </DockPanel>
            </Button>
            <Button Style="{StaticResource Btn.Ghost}" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource Stroke}"
                    HorizontalContentAlignment="Stretch" Padding="16,0" Height="56" Click="OnFolder">
                <DockPanel>
                    <c:SvgIcon DockPanel.Dock="Right" Data="{StaticResource I.External}" Width="14" Height="14" Foreground="{DynamicResource TextSecondary}"/>
                    <c:SvgIcon Data="{StaticResource I.Folder}" Width="20" Height="20" Margin="0,0,16,0"/>
                    <TextBlock Text="程序目录" VerticalAlignment="Center"/>
                </DockPanel>
            </Button>
        </StackPanel>
    </ScrollViewer>
</UserControl>
