<UserControl x:Class="WtfNel.Ui.Pages.AccountEditor"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WtfNel.Ui.Controls">
    <StackPanel>
        <StackPanel x:Name="ChannelArea">
            <TextBlock Text="登录方式" Style="{StaticResource Overline}"/>
            <Border Style="{StaticResource SegmentHost}" HorizontalAlignment="Stretch" Margin="0,0,0,16">
                <UniformGrid Columns="4">
                    <RadioButton x:Name="ChNetease" GroupName="Channel" Style="{StaticResource Segment}" Tag="netease" Checked="OnChannel" Padding="6,7">
                        <StackPanel Orientation="Horizontal">
                            <c:SvgIcon Data="{StaticResource I.Mail}" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="网易邮箱" Margin="6,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Ch4399" GroupName="Channel" Style="{StaticResource Segment}" Tag="4399pc" Checked="OnChannel" Padding="6,7">
                        <StackPanel Orientation="Horizontal">
                            <c:SvgIcon Data="{StaticResource I.User}" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="4399" Margin="6,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="Ch4399Com" GroupName="Channel" Style="{StaticResource Segment}" Tag="4399com" Checked="OnChannel" Padding="6,7">
                        <StackPanel Orientation="Horizontal">
                            <c:SvgIcon Data="{StaticResource I.User}" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="4399com" Margin="6,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ChCookie" GroupName="Channel" Style="{StaticResource Segment}" Tag="cookie" Checked="OnChannel" Padding="6,7">
                        <StackPanel Orientation="Horizontal">
                            <c:SvgIcon Data="{StaticResource I.Cookie}" Width="15" Height="15" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                            <TextBlock Text="Cookie" Margin="6,0,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>
            </Border>
        </StackPanel>

        <StackPanel x:Name="PasswordArea">
            <TextBlock x:Name="UserLabel" Text="邮箱" Style="{StaticResource Overline}"/>
            <TextBox x:Name="UserBox" Margin="0,0,0,14" TextChanged="OnUserChanged"/>
            <TextBlock Text="密码" Style="{StaticResource Overline}"/>
            <PasswordBox x:Name="PasswordBox" Margin="0,0,0,14"/>
        </StackPanel>

        <StackPanel x:Name="CookieArea" Visibility="Collapsed">
            <DockPanel Margin="0,0,0,8">
                <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Ghost}" Padding="8,2" Click="OnImportCookie">
                    <StackPanel Orientation="Horizontal">
                        <c:SvgIcon Data="{StaticResource I.Folder}" Width="14" Height="14" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
                        <TextBlock Text="从文件导入" Margin="6,0,0,0" FontSize="12"/>
                    </StackPanel>
                </Button>
                <TextBlock Text="sauth_json" Style="{StaticResource Overline}" Margin="0" VerticalAlignment="Center"/>
            </DockPanel>
            <TextBox x:Name="CookieBox" Height="110" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top"
                     FontFamily="{StaticResource MonoFont}" FontSize="12" Tag="粘贴 {&quot;sauth_json&quot;: ...} 或 sauth_json 对象" Margin="0,0,0,14"
                     VerticalScrollBarVisibility="Auto"/>
        </StackPanel>

        <TextBlock Text="名称" Style="{StaticResource Overline}"/>
        <TextBox x:Name="NameBox" Tag="在列表里显示的名字"/>

        <Border x:Name="ErrorBar" Visibility="Collapsed" Background="{DynamicResource DangerSoft}" CornerRadius="8" Padding="12,8" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <c:SvgIcon Data="{StaticResource I.Alert}" Width="15" Height="15" Foreground="{DynamicResource Danger}"/>
                <TextBlock x:Name="ErrorText" Foreground="{DynamicResource Danger}" FontSize="12.5" Margin="8,0,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
