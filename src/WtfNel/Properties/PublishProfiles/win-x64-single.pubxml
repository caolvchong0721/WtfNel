<?xml version="1.0" encoding="utf-8"?>
<!--
  单文件发布：Rider 会自动识别本文件，在运行配置下拉里出现「WtfNel: win-x64-single」，选中点运行即可。
  命令行：dotnet publish src\WtfNel\WtfNel.csproj -p:PublishProfile=win-x64-single
  产物：src\WtfNel\bin\publish\WtfNel.exe（自带 .NET 运行时，目标机器无需安装 .NET）
        + 旁边的 LocalRuntime\ 和 WPFLauncher.exe
  注意：不要开 IncludeAllContentForSelfExtract —— 那会让 AppContext.BaseDirectory 变成临时解压目录，
  shadow.json / accounts.json / logs / cache 就不在 exe 旁边了。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>bin\publish\</PublishDir>
  </PropertyGroup>
</Project>
